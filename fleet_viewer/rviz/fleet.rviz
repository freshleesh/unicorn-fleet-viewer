Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 279
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: fleet_rviz_tools/AutodrivePanel
    MaxSpeed_nuc1: 4
    MaxSpeed_nuc4: 4
    MaxSpeed_nuc5: 4.1
    Name: Autodrive
  - Class: fleet_rviz_tools/RacePanel
    Laps: 3
    Name: Race
  - Cells_nuc1: 4
    Cells_nuc4: 4
    Cells_nuc5: 4
    Class: fleet_rviz_tools/BatteryPanel
    Name: Battery
  - Class: fleet_rviz_tools/RecordPanel
    Folder: /home/leesh/bag
    Name: Record
